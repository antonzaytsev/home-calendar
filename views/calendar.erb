<!DOCTYPE html>
<html lang="ru" data-version="<%= frontend_version %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="color-scheme" content="dark">
    <title>Домашний календарь</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="<%= asset_path('calendar.css') %>">
    <script src="<%= asset_path('calendar.js') %>" defer></script>
</head>
<body>
    <header class="top">
        <div class="toolbar">
            <div class="toolbar-side">
                <button type="button" class="nav-button" data-action="prev" title="Предыдущие дни">‹ назад</button>
                <button type="button" class="nav-button" data-action="today" title="На сегодня">сегодня</button>
            </div>
            <h1 id="title"></h1>
            <div class="toolbar-side toolbar-side-end">
                <button type="button" class="nav-button" data-action="next" title="Следующие дни">вперед ›</button>
            </div>
        </div>
        <div class="day-headers" id="day-headers"></div>
        <div class="all-day-row" id="all-day-row" hidden></div>
    </header>

    <main class="grid" id="grid"></main>

    <footer class="footer">
        <span class="status" id="status">Загрузка…</span>
        <button type="button" class="settings-button" data-action="settings">Настройки</button>
    </footer>

    <dialog class="settings" id="settings">
        <form method="dialog">
            <div class="settings-header">
                <h3>Настройки</h3>
                <button value="cancel" class="settings-close" aria-label="Закрыть">×</button>
            </div>
            <fieldset class="settings-body">
                <legend>Количество видимых дней:</legend>
                <label class="day-option"><input type="radio" name="totalDays" value="3"> 3 дня</label>
                <label class="day-option"><input type="radio" name="totalDays" value="4"> 4 дня</label>
                <label class="day-option"><input type="radio" name="totalDays" value="5"> 5 дней</label>
                <label class="day-option"><input type="radio" name="totalDays" value="7"> 7 дней</label>
            </fieldset>
            <div class="settings-footer">
                <button value="save" class="btn-save">Сохранить</button>
                <button value="cancel" class="btn-cancel">Отмена</button>
            </div>
        </form>
    </dialog>
</body>
</html>
